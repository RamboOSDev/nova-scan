{
  "name": "nova-scan",
  "version": "0.1.0",
  "description": "Security scanner for AI-generated code (Cursor, Lovable, v0, bolt) — catches hardcoded secrets, client env leaks, and unauthenticated backend calls",
  "main": "dist/index.js",
  "bin": {
    "nova-scan": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "security",
    "security-scanner",
    "ai",
    "ai-generated-code",
    "cursor",
    "lovable",
    "v0",
    "supabase",
    "secrets",
    "static-analysis",
    "cli"
  ],
  "author": "Nova Security",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RamboOSDev/nova-scan.git"
  },
  "bugs": "https://github.com/RamboOSDev/nova-scan/issues",
  "homepage": "https://github.com/RamboOSDev/nova-scan#readme",
  "dependencies": {
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "vitest": "^4.1.7"
  }
}
